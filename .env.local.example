# Copiá este archivo como ".env.local" y completá tu clave.
# Conseguí una API key GRATIS de Google Gemini (sin tarjeta) en:
# https://aistudio.google.com/apikey

GEMINI_API_KEY=PEGA_TU_CLAVE_AQUI

# Opcional. Modelo de Gemini a usar.
# Por defecto gemini-2.5-flash (gratuito, rápido y con visión).
GEMINI_MODEL=gemini-2.5-flash
